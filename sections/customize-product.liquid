
<style>
    .customize-pro-wrap {
    display: grid;
    grid-template-columns: 1fr 1fr;
}

.img-wrap img {width: 100%;height: 100%;object-fit: contain;}
.img-wrap {
    max-width: 450px;
    margin: auto;
}
</style>
<div class="customize-pro-wrap">
    <div class="img-wrap">
        <img src='https://cdn.shopify.com/s/files/1/0742/0143/2301/files/customize-tshirt-base.png?v=1761116991'>
        <div class="color-overlay"></div>
    </div>
    <div class="info-wrap">
        {{ product.title }}
        <input type="color" class="color-input" value="#ff0000">
    </div>
</div>
{% schema %}
{
  "name": "Customize product",
  "tag": "section",
  "class": "section",
  "presets": [
    {
      "name": "Customize product"
    }
  ]
}
{% endschema %}
