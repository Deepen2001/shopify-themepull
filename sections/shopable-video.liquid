{% comment %}
  Section: UGC Reels / Social Proof Grid
  File: ugc-reels.liquid
  Notes:
  - Add this file to /sections then add the section in the theme editor.
  - Each block = 1 card (video + product info).
  - If product is set, title/price auto-fill (you can still override title per block).
{% endcomment %}

<section
  class="ugc-reels section-{{ section.id }}"
  style="--cols: {{ section.settings.desktop_columns }};"
>
  <div class="ugc-reels__inner page-width">
    {% if section.settings.heading != blank %}
      <h2 class="ugc-reels__heading">
        {{ section.settings.heading }}
      </h2>
    {% endif %}

    <div class="ugc-reels__grid" role="list">
      {% for block in section.blocks %}
        {% assign p = all_products[block.settings.product] %}
        {% assign featured_image = block.settings.thumb_image | default: p.featured_image %}
        {% assign show_compare = false %}
        {% if p and p.compare_at_price_max > p.price_max %}
          {% assign show_compare = true %}
        {% endif %}

        <article class="ugc-card" role="listitem" {{ block.shopify_attributes }}>
          <div class="ugc-card__media">
            {% if block.settings.show_badge and block.settings.badge != blank %}
              <span class="ugc-card__badge" style="background-color: {{ block.settings.badge_bg_color }}; color: {{ block.settings.badge_text_color }};">{{ block.settings.badge }}</span>
            {% endif %}

            {% if section.settings.show_view_count and block.settings.view_count != blank %}
              <span class="ugc-card__views" aria-label="views">
                <span class="ugc-card__views-icon" aria-hidden="true">👁</span>
                {{ block.settings.view_count }}
              </span>
            {% endif %}

            {%- assign video = block.settings.video -%}
            {%- assign video_url = block.settings.video_url -%}

            {% if video != blank %}
                {{ video | video_tag:
                  image_size: '1100x',
                  autoplay: false,
                  loop: true,
                  controls: false,
                  muted: true,
                  playsinline: true,
                  class: 'ugc-card__video'
                }}
            {% elsif video_url != blank %}
                  <video
                    class="ugc-card__video"
                    playsinline
                    loop
                    preload="metadata"
                    muted
                  >
                    <source src="{{ video_url }}" type="video/mp4">
                  </video>
            {% else %}
              {% if featured_image %}
                <img
                  class="ugc-card__fallback"
                  src="{{ featured_image | image_url: width: 1100 }}"
                  alt="{{ featured_image.alt | escape }}"
                  loading="lazy"
                >
              {% else %}
                <div class="ugc-card__placeholder" aria-hidden="true"></div>
              {% endif %}
            {% endif %}

            <button class="ugc-card__play" type="button" aria-label="Play or pause">
              <svg viewBox="0 0 100 100" width="44" height="44" aria-hidden="true">
                <circle cx="50" cy="50" r="48" stroke-width="4" fill="rgba(0,0,0,.45)" />
                <polygon class="icon--play" points="40,30 75,50 40,70" fill="#fff"/>
                <g class="icon--pause" style="display:none">
                  <rect x="38" y="32" width="10" height="36" fill="#fff" />
                  <rect x="56" y="32" width="10" height="36" fill="#fff" />
                </g>
              </svg>
            </button>
          </div>

          <a
            {% if p %}href="{{ p.url }}"{% else %}href="{{ block.settings.link | default: '#' }}"{% endif %}
            class="ugc-card__meta"
          >
            <div class="ugc-card__thumb">
              {% if featured_image %}
                <img
                  src="{{ featured_image | image_url: width: 160 }}"
                  alt="{{ featured_image.alt | escape }}"
                  loading="lazy"
                >
              {% endif %}
            </div>

            <div class="ugc-card__info">
              <div class="ugc-card__title">
                {%- if block.settings.custom_title != blank -%}
                  {{ block.settings.custom_title }}
                {%- elsif p -%}
                  {{ p.title }}
                {%- else -%}
                  {{ 'products.product.title' | t }}
                {%- endif -%}
              </div>

              <div class="ugc-card__price">
                {% if p %}
                  {% assign price = p.price | money %}
                  {% assign compare = p.compare_at_price_max | money %}
                  {% if show_compare %}
                    <span class="ugc-card__compare">{{ compare }}</span>
                  {% endif %}
                  <span class="ugc-card__current">{{ price }}</span>
                {% elsif block.settings.price_text != blank %}
                  <span class="ugc-card__current">{{ block.settings.price_text }}</span>
                {% endif %}
              </div>
            </div>

            {% if section.settings.show_wishlist %}
              <span class="ugc-card__wish" aria-hidden="true">♡</span>
            {% endif %}
          </a>
        </article>
      {% endfor %}
    </div>
  </div>

  <style>
    .section-{{ section.id }} .ugc-reels__inner { padding-block: clamp(24px, 4vw, 48px); }
    .ugc-reels__heading {
      text-align: center;
      letter-spacing: .02em;
      text-transform: uppercase;
      font-size: clamp(20px, 2.6vw, 36px);
      margin: 0 0 24px;
    }

    .ugc-reels__grid {
      display: grid;
      grid-template-columns: repeat(var(--cols, 4), minmax(0, 1fr));
      gap: 18px;
    }

    /* Mobile: horizontal snap-scroller */
    @media (max-width: 749px) {
      .ugc-reels__grid {
        display: flex;
        flex-direction: row;
        overflow-x: auto;
        gap: 18px;
        padding-bottom: 8px;
        scroll-snap-type: x mandatory;
        -webkit-overflow-scrolling: touch;
        {% comment %} display: grid;
        grid-auto-flow: column;
        grid-auto-columns: 80%;
        overflow-x: auto;
        padding-bottom: 8px;
        scroll-snap-type: x mandatory;
        -webkit-overflow-scrolling: touch; {% endcomment %}
      }
      .ugc-card {  width: 80%;
    flex-shrink: 0;
    scroll-snap-align: start; }
    }

    .ugc-card {
      border-radius: {{ section.settings.border_radius | default: 18 }}px;
      overflow: hidden;
      background: var(--color-bg, #fff);
      box-shadow: 0 6px 22px rgba(0,0,0,.06);
      display: flex;
      flex-direction: column;
      position: relative;
    }

    .ugc-card__media {
      position: relative;
      aspect-ratio: 3 / 5;
      background: #f3f3f3;
      overflow: hidden;
    }
    .ugc-card__video,
    .ugc-card__fallback {
      width: 100%;
      height: 100%;
      object-fit: cover;
      display: block;
    }
    .ugc-card__badge {
      position: absolute; top: 10px; left: 10px;
      font-size: 12px; 
      padding: 4px 8px; 
      line-height: 1;
    }
    .ugc-card__views {
      position: absolute; top: 10px; right: 10px;
      font-size: 12px; font-weight: 600;
      background: rgba(255,255,255,.9); padding: 4px 8px; 
      display: inline-flex; align-items: center; gap: 6px;
      line-height: 1;
    }
    .ugc-card__play {
      position: absolute; inset: 0;
      display: grid; place-items: center;
      border: 0; background: none; cursor: pointer;
    }
    .ugc-card__play:focus-visible { outline: 2px solid #000; outline-offset: -2px; }

    .ugc-card__meta {
      text-decoration: none;
      color: inherit;
      display: grid;
      grid-template-columns: 64px 1fr auto;
      gap: 12px;
      align-items: center;
      padding: 6px;
      position: absolute;
      backdrop-filter: blur(8px); 
      background: rgba(255,255,255,.85);
      left: 5px; right: 5px;
      bottom: 5px;
    }
    .ugc-card__thumb img { width: 65px; height: 80px; object-fit: cover; display:block; }
    .ugc-card__title {
      font-size: 14px; line-height: 1.2;
      display: -webkit-box; -webkit-line-clamp: 2; -webkit-box-orient: vertical; overflow: hidden;
    }
    .ugc-card__price { margin-top: 6px; font-size: 14px; }
    .ugc-card__compare { text-decoration: line-through; opacity: .6; margin-right: 6px; }
    .ugc-card__current { font-weight: 700; }
    .ugc-card__wish { font-size: 18px; opacity: .7; }

    /* subtle hover */
    @media (hover:hover) {
      .ugc-card:hover { transform: translateY(-2px); transition: transform .2s ease; }
    }

    .ugc-card.is-playing .ugc-card__play {
      opacity: 0;
      pointer-events: none;
    }
    .ugc-card.is-playing {
      cursor: url('data:image/svg+xml;utf8,<svg xmlns="http://www.w3.org/2000/svg" width="32" height="32"><rect x="8" y="6" width="6" height="20" fill="black"/><rect x="18" y="6" width="6" height="20" fill="black"/></svg>') 16 16, pointer;
    }
  </style>

  <script>
    (function() {
      const root = document.currentScript.closest('section');
      const cards = root.querySelectorAll('.ugc-card');

      cards.forEach(card => {
        const video = card.querySelector('.ugc-card__video');
        const btn   = card.querySelector('.ugc-card__play');
        if (!video || !btn) return;

        const iconPlay  = btn.querySelector('.icon--play');
        const iconPause = btn.querySelector('.icon--pause');

        function setState(playing) {
          iconPlay.style.display  = playing ? 'none' : 'block';
          iconPause.style.display = playing ? 'block' : 'none';
          if (playing) {
            card.classList.add('is-playing');
          } else {
            card.classList.remove('is-playing');
          }
        }

          btn.addEventListener('click', () => {
              if (video.paused) {
                // Pause all other videos in the section
                cards.forEach(otherCard => {
                  const otherVideo = otherCard.querySelector('.ugc-card__video');
                  if (otherVideo && otherVideo !== video) {
                    otherVideo.pause();
                  }
                });
                video.muted = false;
                video.play().catch(() => {/* ignore */});
                setState(true);
              } else {
                video.pause();
                setState(false);
              }
            });

        // Reset icons on end (in case autoplay is off)
        video.addEventListener('pause', () => setState(false));
        video.addEventListener('play',  () => setState(true));
      });
    })();
  </script>
</section>

{% schema %}
{
  "name": "Shopable video",
  "tag": "section",
  "class": "section",
  "settings": [
    { "type": "text", "id": "heading", "label": "Heading", "default": "SEE PEOPLE GO GAGA OVER OUR TRADITIONALS" },
    {
      "type": "range",
      "id": "desktop_columns",
      "min": 2, "max": 5, "step": 1,
      "label": "Desktop columns",
      "default": 4
    },
    { "type": "checkbox", "id": "autoplay", "label": "Autoplay videos", "default": true },
    { "type": "checkbox", "id": "muted", "label": "Mute videos", "default": true },
    { "type": "checkbox", "id": "show_view_count", "label": "Show view count on cards", "default": true },
    { "type": "checkbox", "id": "show_wishlist", "label": "Show wishlist heart (decorative)", "default": false },
    {
      "type": "range",
      "id": "border_radius",
      "min": 0,
      "max": 36,
      "step": 1,
      "label": "Card border radius (px)",
      "default": 18
    }
  ],
  "blocks": [
    {
      "type": "card",
      "name": "Video card",
      "settings": [
        { "type": "product", "id": "product", "label": "Product" },
        { "type": "image_picker", "id": "thumb_image", "label": "Mini thumbnail (optional)" },

        { "type": "video", "id": "video", "label": "Shopify video (recommended)" },
        { "type": "url", "id": "video_url", "label": "MP4 video URL (fallback if no Shopify video)" },

        { "type": "checkbox", "id": "show_badge", "label": "Show badge", "default": true },
        { "type": "text", "id": "badge", "label": "Badge text", "default": "NEW" },
        { "type": "color", "id": "badge_bg_color", "label": "Badge background color", "default": "#2a6bff" },
        { "type": "color", "id": "badge_text_color", "label": "Badge text color", "default": "#ffffff" },

        { "type": "text", "id": "view_count", "label": "View count (e.g. 3.8K)", "default": "3.8K" },

        { "type": "text", "id": "custom_title", "label": "Custom title (override product title)" },
        { "type": "text", "id": "price_text", "label": "Custom price (if no product)" },
        { "type": "url", "id": "link", "label": "Card link (if no product)" }
       
      ]
    }
  ],
  "presets": [
    {
      "name": "Shopable video",
      "category": "Media",
      "blocks": [
        { "type": "card" },
        { "type": "card" },
        { "type": "card" },
        { "type": "card" }
      ]
    }
  ]
}
{% endschema %}
